# Defaults for the water tank firmware (ESP32-WROOM-32 class dev board, CH340 bridge).
# Applied when no sdkconfig exists yet; run `idf.py fullclean` or delete sdkconfig to re-apply.
CONFIG_IDF_TARGET="esp32"

# Flash: 4 MB assumed (gap G2/G4 in SYSTEM_ARCHITECTURE.md)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console on UART0 (GPIO1/GPIO3 -> CH340) at 115200 baud, matching the bench "UART @115200"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Logging. No ANSI colour codes, so report lines stay machine-parseable (§8).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_COLORS is not set

# Project defaults (see main/Kconfig.projbuild)
CONFIG_WT_SENSOR_UART_NUM=2
CONFIG_WT_SENSOR_RX_GPIO=16
CONFIG_WT_SENSOR_TX_GPIO=17
CONFIG_WT_REPORT_PERIOD_MS=1000
CONFIG_WT_SENSOR_STALE_MS=1000
# CONFIG_WT_MEDIAN_FILTER is not set

# Stage 2: Wi-Fi + MQTT need more than the default 1 MB app partition (§5.8).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Home network (operator request, run #14). Anyone who can read this repository
# can read these values: if the repository is public, move them to NVS
# (tools/nvs_config.example.csv, keys wifi_ssid / wifi_pass) and clear them here.
CONFIG_WT_WIFI_SSID="weefee"
CONFIG_WT_WIFI_PASSWORD="rptw-b5w3-bbps-52e4"
# Hostname (operator request, run #18). wt_wifi sets it on the STA netif; the lwIP
# default is set too so any other netif uses the same name.
CONFIG_WT_WIFI_HOSTNAME="espwatertank"
CONFIG_LWIP_LOCAL_HOSTNAME="espwatertank"

# Web report to the PHP server in web/water/. The key must equal
# $config['api_key'] in web/water/config.php (change both together).
CONFIG_WT_WEB_ENABLE=y
CONFIG_WT_WEB_POST_URL="https://randoresto.ch/water/post.php"
CONFIG_WT_WEB_API_KEY="wt-q7m2x9k4p8v3n6c1"
CONFIG_WT_WEB_POST_PERIOD_MS=60000
# HTTPS: verify the server against the built-in CA bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Home Assistant compiled in; it stays off at runtime until a broker URI is set (§5.2).
# No MQTT credentials here: use NVS (tools/nvs_config.example.csv) or a local sdkconfig.
CONFIG_WT_HA_ENABLE=y
